# roadmap2yes - example environment. Copy to `.env.local` (git-ignored). FAKE values only:
# this repository is public. Never commit real emails, keys or access codes (`.env*` is ignored).
#
# Local stack: `npm run db:start`, then append the three Supabase values with
#   npm run -s db:env >> .env.local
# (the keys printed by the local Supabase CLI are throw-away demo keys of YOUR machine's stack).

# --- Supabase (plan §11) ---------------------------------------------------------------------
# Local stack uses port 54421 (non-default, see supabase/config.toml).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_LOCAL_KEY
# Server-only. Never prefix with NEXT_PUBLIC_. Used by src/lib/supabase/admin.ts and, as the HMAC key
# of the login limiter, by src/features/auth/login.ts (rotating it resets the limiter counters).
SUPABASE_SECRET_KEY=sb_secret_REPLACE_WITH_LOCAL_KEY

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- First user (bootstrap, create-only; plan §4.2) -------------------------------------------
# Server-only. All three needed, otherwise nothing happens. In staging/prod they live only in
# Vercel (marked Sensitive). The code must be >= 10 chars with letters and digits.
R2Y_BOOTSTRAP_EMAIL=tony@example.test
R2Y_BOOTSTRAP_ACCESS_CODE=local-demo-code-2026
R2Y_BOOTSTRAP_ROLE=sposo

# --- Login limiter (plan §4.3; defaults shown) ------------------------------------------------
R2Y_LOGIN_MAX_FAILURES_EMAIL=5
R2Y_LOGIN_MAX_FAILURES_IP=20
R2Y_LOGIN_LOCK_MINUTES=15

# --- Email (plan §7): absent or `none` = NO email, with a banner in the app -------------------
# Local/CI app emails: the Mailpit catcher started by `npm run db:start`:
#   SMTP_HOST=127.0.0.1  SMTP_PORT=54425  MAILPIT_API_URL=http://127.0.0.1:54426 (web UI + API, used by e2e)
EMAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=54425
MAILPIT_API_URL=http://127.0.0.1:54426
# Production only, after the domain exists (EMAIL_TRANSPORT=resend):
# RESEND_API_KEY=
# EMAIL_FROM=
EMAIL_DAILY_CAP=50
EMAIL_MONTHLY_CAP=1500

# --- Cron and email links (fake locally, random in Preview/Production) ------------------------
CRON_SECRET=local-fake-cron-secret
# Min 32 chars. Generate a random one with: openssl rand -base64 32
EMAIL_LINK_SECRET=local-fake-email-link-secret-0123456789

# --- RSVP personal links (FEAT-2026-004) -------------------------------------------------------
# Min 32 chars. Signs the RSVP link tokens. In Vercel use a DIFFERENT random value per environment
# (openssl rand -base64 48), marked Sensitive; the fake value below is refused in Production.
RSVP_LINK_SECRET=local-fake-rsvp-secret-0123456789abcdef

# --- e2e only: lets specs move time with the `r2y-test-now` cookie. NEVER in Vercel. ----------
# E2E_CLOCK=1
