{
  "name": "roadmap2yes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.8",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.79.0",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "3.3.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint . && npm run check:test-emails",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:tz": "TZ=UTC vitest run --project unit && TZ=America/Los_Angeles vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "e2e": "playwright test --pass-with-no-tests",
    "e2e:install": "playwright install --with-deps chromium webkit",
    "db:start": "supabase start -x storage-api,imgproxy,realtime,studio,edge-runtime,logflare,vector,supavisor,postgres-meta && npm run mail:start",
    "db:stop": "npm run mail:stop; supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts.tmp && mv src/lib/supabase/database.types.ts.tmp src/lib/supabase/database.types.ts",
    "db:env": "supabase status -o json 2>/dev/null | node -e \"let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{const j=JSON.parse(s);console.log('NEXT_PUBLIC_SUPABASE_URL='+j.API_URL+'\\\\nNEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY='+j.PUBLISHABLE_KEY+'\\\\nSUPABASE_SECRET_KEY='+j.SECRET_KEY)})\"",
    "mail:start": "docker start roadmap2yes-mailpit 2>/dev/null || docker run -d --name roadmap2yes-mailpit -p 127.0.0.1:54425:1025 -p 127.0.0.1:54426:8025 public.ecr.aws/supabase/mailpit:v1.31.3@sha256:ed9b00c609e77e99c79b93f1178255ebc271868920f2c69a8d166bd5634ed10d",
    "mail:stop": "docker rm -f roadmap2yes-mailpit >/dev/null 2>&1 || true",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "gen:themes": "tsx scripts/gen-themes-css.ts",
    "check:fonts": "tsx scripts/check-font-budget.ts",
    "keepalive:check": "tsx scripts/keepalive-check.ts",
    "check:test-emails": "tsx scripts/check-test-emails.ts",
    "format": "prettier --no-error-on-unmatched-pattern --write src scripts tests e2e .github \"*.{ts,mjs,json}\"",
    "format:check": "prettier --no-error-on-unmatched-pattern --check src scripts tests e2e .github \"*.{ts,mjs,json}\""
  }
}
